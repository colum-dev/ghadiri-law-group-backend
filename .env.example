NODE_ENV=development
PORT=4000
# آدرسی که از بیرون به همین API می‌رسد (برای ساختن آدرس کامل عکس‌ها)
PUBLIC_URL=http://localhost:4000
# آدرس سایت Next.js (چند آدرس را با کاما جدا کن)
CORS_ORIGINS=http://localhost:3001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ghadiri
DB_PASSWORD=change_me
DB_NAME=ghadiri

# یک رشتهٔ تصادفی طولانی؛ مثلاً: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# lax: وقتی سایت و API هم‌سایت (same-site) باشند. none: فقط با HTTPS و دامنه‌های متفاوت
COOKIE_SAMESITE=lax

UPLOAD_DIR=uploads

# فقط برای db:seed (اولین ادمین)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
